# ============================================================
# Self Publish Studio - Environment Variables
# ============================================================
# Copy this file to .env and fill in your Supabase credentials.

# Supabase Project Configuration
# Find these in your Supabase Dashboard: Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173

# Local development only: set to true if your network/proxy breaks Supabase TLS verification.
# Prefer installing your proxy/root CA instead of using this in production.
SUPABASE_ALLOW_INSECURE_TLS=false

# Email Configuration
# For Gmail, use an app password for SMTP_PASS, not your normal Gmail password.
QUOTE_RECIPIENT_EMAIL=selfpublish57@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=selfpublish57@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=selfpublish57@gmail.com

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3001/api/v1
